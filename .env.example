# Copy to .env

# --- Aerlink operations API (local) ------------------------------------------
OPS_BASE_URL=http://127.0.0.1:8642
OPS_API_KEY=aerlink-ops-local-key

# Optional: change where the local API listens.
# OPS_HOST=127.0.0.1
# OPS_PORT=8642

# --- OpenAI -------------------------------------------------------------------
# We will send you a key separately. It has a hard spending cap of roughly $15-20.
OPENAI_API_KEY=

# Optional: point at a different (e.g. cheaper/compatible) endpoint during development.
# Leave blank to use the real OpenAI API.
# OPENAI_BASE_URL=

# Optional: defaults to gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini

# --- Agent autonomy -------------------------------------------------------------
# Any single write action above this amount must be escalated to a human instead
# of actioned automatically. Optional, defaults to 300.
# AUTONOMY_LIMIT_GBP=300

# Separate, higher cap on the running total of money committed across all write actions
# in one case. An action under the per-action limit can still be blocked if it would push
# the case's cumulative total over this. Optional, defaults to 500.
# CUMULATIVE_LIMIT_GBP=500

# --- Cost tracking ---------------------------------------------------------------
# Per-1M-token USD rates used to estimate spend. Defaults to gpt-4o-mini's published
# rates; override if OPENAI_MODEL points at something else so the estimate stays real.
# OPENAI_INPUT_PRICE_PER_1M_USD=0.15
# OPENAI_OUTPUT_PRICE_PER_1M_USD=0.60
